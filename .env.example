# Copy this file to .env, then replace every placeholder before starting the app.
# Environment variables override values from .env.

# PostgreSQL 18+ Configuration (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cs2_manager
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=cs2_manager

# Database Pool and Automatic Migration Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
DB_ECHO=False
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=300

# Redis Configuration (required; leave REDIS_PASSWORD empty when no password is set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional. Prefix Redis keys so two panels can share REDIS_DB=0.
# REDIS_KEY_PREFIX=
# Optional. Session cookie becomes upkk_access_token_<suffix> (public port).
# SESSION_COOKIE_SUFFIX=

# Redis Connection Pool Configuration (for improved performance)
REDIS_POOL_SIZE=10
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
RUN_MODE=production
BACKEND_URL=http://localhost:8000
# Next.js console proxy target lives in frontend/.env (INTERNAL_API_URL).
# Optional stable Base64 AES key for independently built or multi-instance
# Next.js deployments. It is consumed only as a BuildKit secret; never commit
# it or place it in a container runtime environment.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public Next.js / Caddy origin. FastAPI leftover HTML pages 307 here.
# Public users should enter through Caddy → Next, not :8000.
CONSOLE_PUBLIC_URL=http://127.0.0.1:31800
# redirect (default) | serve | gone
LEGACY_HTML_CONSOLE=redirect

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL is the level the rotating log file keeps. How much of it reaches
# the console is an administrator setting (System settings → Logging, default
# "Errors only"); set that to "Follow the environment" to use LOG_LEVEL there.
LOG_LEVEL=INFO
ASYNCSSH_LOG_LEVEL=WARNING

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional override. When empty, the panel creates and reuses:
# data/ai_credential_encryption.key
AI_CREDENTIAL_ENCRYPTION_KEY=

# SSH Authentication Configuration: password, key, or both
SSH_AUTH_MODE=password

# Google OAuth Configuration (optional; leave empty to disable)
GOOGLE_CLIENT_ID=
