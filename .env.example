# Copy this file to .env, then replace every placeholder before starting the app.
# Environment variables override values from .env.

# Database Configuration (required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cs2_manager
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cs2_manager
# Used only by Docker Compose to initialize MySQL. Keep it distinct from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=your_distinct_mysql_root_password

# MySQL Connection Pool Configuration (for improved performance)
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=3600
MYSQL_POOL_PRE_PING=True
MYSQL_ECHO=False

# Redis Configuration (a password is required by the supplied Compose stack)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Redis Connection Pool Configuration (for improved performance)
REDIS_POOL_SIZE=10
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Application Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
BACKEND_URL=http://localhost:8000
# Registration defaults to enabled here and disabled when ENVIRONMENT=production.
# Set ALLOW_REGISTRATION=true only when public sign-up is intentional.

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
ASYNCSSH_LOG_LEVEL=WARNING
# Optional. When empty, /metrics responds as not found. Use 32+ random characters in production.
METRICS_BEARER_TOKEN=

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Credential protection. Required in production. Generate a key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ACTIVE_KEY_ID=
TOKEN_HASH_KEY=

# SSH Authentication Configuration: password, key, or both
SSH_AUTH_MODE=password

# Google OAuth Configuration (optional; leave empty to disable)
GOOGLE_CLIENT_ID=
