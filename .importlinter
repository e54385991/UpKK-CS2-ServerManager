[importlinter]
root_package = cs2_manager
include_external_packages = True

[importlinter:contract:package-layers]
name = Core, infrastructure, and feature layers flow in one direction
type = layers
layers =
    cs2_manager.features
    cs2_manager.infrastructure
    cs2_manager.core

[importlinter:contract:core-is-framework-independent]
name = Core does not depend on legacy application modules
type = forbidden
source_modules =
    cs2_manager.core
forbidden_modules =
    api
    modules
    services
    cs2_manager.infrastructure
