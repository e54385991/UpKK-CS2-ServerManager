# 1Panel public edge: Caddy → Next → FastAPI.
# PANEL_APP_PORT_HTTP publishes this container's :80.
# FastAPI stays on container port 8000. Do not publish or remap it to 8001.
# app / frontend / caddy share a private compose network so service names
# do not collide with a second install on 1panel-network.
# /google-callback is a Next public page (Google OAuth popup).
{
	admin off
}

:80 {
    encode gzip

	reverse_proxy frontend:3000 {
		flush_interval -1
	}
}
