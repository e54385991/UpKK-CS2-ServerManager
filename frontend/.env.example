# Copy this file to frontend/.env, then restart `npm run dev`.
# Next loads these files from this directory only (not the repo-root .env).
# Process environment variables override values from .env.

# Optional. Leave unset to derive the public origin from the request Host
# (and X-Forwarded-Host / X-Forwarded-Proto), including the port the browser
# used. Bind addresses such as http://0.0.0.0:3005 are ignored.
# PUBLIC_APP_URL=http://localhost:3000

# Extra hosts allowed to open `next dev` besides localhost / 127.0.0.1 /
# this machine's LAN IPs. Comma-separated, no scheme or port.
# ALLOWED_DEV_ORIGINS=panel.lan,cs2.local

# Internal FastAPI origin. Next proxies /api/*, /health, and /static/* here
# server-side (including WebSocket upgrades for the live console). The browser
# never contacts this directly.
#
# Local `next dev`:
#   INTERNAL_API_URL=http://127.0.0.1:8000
# Docker Compose / 1Panel (service name `app`):
#   INTERNAL_API_URL=http://app:8000
# A FastAPI process on another host or port:
#   INTERNAL_API_URL=http://192.168.1.10:8000
#
# Changing this requires a Next restart. Production standalone images apply it
# at process start (see scripts/with-internal-api-url.mjs).
INTERNAL_API_URL=http://127.0.0.1:8000

# Playwright E2E (`npm run test:e2e`) logs in by reading the CAPTCHA code from
# Redis (`captcha:<token>`) in the test process. Production captcha stays on.
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB inherit from the backend
# `.env` when unset. Defaults: admin / admin123 against http://localhost:3000.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# E2E_USERNAME=admin
# E2E_PASSWORD=admin123
