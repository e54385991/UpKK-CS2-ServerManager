# Public origin the browser uses to reach this app (used for absolute URLs, OAuth
# redirects, and canonical links). In the three-service topology this is the
# Caddy gateway origin.
PUBLIC_APP_URL=http://localhost:3000

# Internal FastAPI origin. Next proxies /api/* and /health here server-side.
# The browser never contacts this directly. In production it is the private
# API listener (e.g. http://api:8001); in local dev it is your FastAPI server.
INTERNAL_API_URL=http://127.0.0.1:8000
