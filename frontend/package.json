{
  "name": "cs2-server-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated Next.js console for the CS2 Server Manager.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node ./scripts/with-internal-api-url.mjs",
    "build:start": "npm run build && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "npx -y openapi-typescript@7 ../tests/baselines/openapi.json -o src/shared/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "clsx": "2.1.1",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
